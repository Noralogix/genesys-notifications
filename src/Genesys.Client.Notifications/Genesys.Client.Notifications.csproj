<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Authors>Noralogix</Authors>
    <Company>Noralogix</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>© Noralogix. All rights reserved.</Copyright>
    <PackageTags>Genesys Purecloud notifications websocket</PackageTags>
    <NeutralLanguage>en</NeutralLanguage>
    <Description>Lightweight client for Genesys Notifications websocket API</Description>
    <PackageIcon>noralogix.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Noralogix/genesys-notifications</PackageProjectUrl>
    <AssemblyVersion>6.0.0.0</AssemblyVersion>
    <FileVersion>6.0.0.0</FileVersion>
    <RepositoryUrl>https://github.com/Noralogix/genesys-notifications</RepositoryUrl>
    <Version>6.1.2</Version>
    <PackageReleaseNotes>Implemented TopicTypeResolver for multiple concatenated topics.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\imgs\noralogix.png" Link="noralogix.png" />
    <None Include="..\..\imgs\noralogix.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\sample\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.3" />
    <PackageReference Include="System.Text.Json" Version="6.0.7" />
    <PackageReference Include="Websocket.Client" Version="4.6.1" />
  </ItemGroup>

</Project>
